LLM_PROVIDER=groq
LLM_FALLBACK=nvidia
# Get free keys: https://console.groq.com and https://build.nvidia.com
# Copy .env.example to .env and fill real values (never commit .env):
# GROQ_API_KEY=gsk-placeholder-here
# NVIDIA_API_KEY=nvapi-placeholder-here
# GROQ_MODEL=llama-3.1-8b-instant
# NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
